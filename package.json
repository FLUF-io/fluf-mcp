{
  "name": "fluf-mcp",
  "version": "0.1.1",
  "mcpName": "io.fluf/mcp",
  "description": "Model Context Protocol server for FLUF Connect — crosslisting, inventory sync, orders and offers across Depop, eBay, Shopify, Etsy, Vinted, Facebook and more.",
  "type": "module",
  "bin": {
    "fluf-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "fluf",
    "crosslisting",
    "depop",
    "ebay",
    "shopify",
    "etsy",
    "vinted",
    "reselling",
    "marketplace"
  ],
  "author": "FLUF.io",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FLUF-io/fluf-mcp.git"
  },
  "homepage": "https://fluf.io",
  "bugs": {
    "url": "https://github.com/FLUF-io/fluf-mcp/issues"
  }
}
